// Apeployee Database Schema v2 — X-account identity, no wallet connect.
// SQLite so the app runs anywhere with zero setup; swap provider for production.
// Note: SQLite has no enums — status/tier fields are strings, documented inline.
// Money is stored as integer lamports in Float columns (exact below 2^53);
// every write rounds to an integer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  xId            String?  @unique // X account id (live OAuth mode)
  xUsername      String   @unique // handle, without @
  xVerified      Boolean  @default(false) // true only via real X OAuth
  demo           Boolean  @default(false) // created via demo sign-in (no X creds configured)
  payoutAddress  String? // Solana address the user pasted; destination only, never connected
  apeRank        String   @default("CHIMPANZEE") // CHIMPANZEE|BABOON|ORANGUTAN|GORILLA|SILVERBACK
  totalShills    Int      @default(0)
  balance        Float    @default(0) // claimable lamports
  lifetimeEarned Float    @default(0) // lamports ever earned
  nftBoost       Float    @default(1.0) // highest owned pass boost; written by NFT service only
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications Application[]
  shills       ShillRecord[]
  payments     Payment[]
  passes       NftPass[]
}

model Job {
  id          String  @id @default(cuid())
  role        String  @unique // BAG_WORKER | MEME_MAKER | ...
  title       String
  emoji       String
  description String
  perk        String // flavor text shown on the job card
  openings    Int     @default(999)
  active      Boolean @default(true)

  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    String   @default("APELOYED") // APELOYED | PENDING | REJECTED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
}

model ShillRecord {
  id           String    @id @default(cuid())
  tweetId      String    @unique // global first-claim dedup
  userId       String
  text         String?
  likes        Int       @default(0)
  retweets     Int       @default(0)
  replies     Int       @default(0)
  views        Int       @default(0)
  earned       Float     @default(0) // lamports credited so far for this tweet
  simulated    Boolean   @default(false) // true when metrics are demo-generated
  createdAt    DateTime  @default(now())
  lastPolledAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// The NFT register: all 1000 Worker Passes from nft/output, imported at seed time.
// ownerId set when a pass is mined to a worker; mintSig set once minted on-chain.
model NftPass {
  id         Int       @id // 1..1000, matches nft/output image/metadata numbering
  tier       String // Common | Uncommon | Rare | Epic | Legendary
  boost      Float // 1.05 .. 1.5
  background String
  fur        String
  outfit     String
  eyewear    String
  headwear   String
  item       String
  ownerId    String?
  minedAt    DateTime?
  mintSig    String? // on-chain cNFT mint signature once minted (later phase)

  owner User? @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([tier, ownerId])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  amount    Float // lamports
  address   String
  status    String // COMPLETED | SIMULATED | FAILED
  signature String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model VaultEvent {
  id        String   @id @default(cuid())
  type      String // FEE_SWEEP | PAYOUT | ADJUST
  amount    Float // lamports, positive = into vault
  note      String?
  createdAt DateTime @default(now())
}
